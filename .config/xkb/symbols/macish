// Mac-style US layout for Linux/Hyprland.
//
// Base is xkeyboard-config's official "us(mac)" variant: it replicates the
// real macOS Option-key dead-key chart (Option+e -> acute, Option+u ->
// diaeresis, Option+i -> circumflex, Option+n -> tilde, Option+` -> grave,
// Option+c -> ç directly) while leaving apostrophe/quote/backtick as plain
// ASCII at levels 1-2, so contractions ("I'm") and code (quotes, backticks)
// never trigger accent composition.
//
// us(mac) drives its dead keys off Right Alt (via level3(ralt_switch)). On
// top of that we swap Left Alt <-> Left Super so the physical key order
// matches macOS's Ctrl-Option-Cmd layout: the key next to Space becomes
// Super (Cmd, used for the Hyprland mod key), and the key that used to be
// Super becomes a second Option/accent-dead-key trigger mirroring Right Alt.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(mac)"
    name[Group1] = "English (US, Mac-like)";

    key <LALT> { [ Super_L ], type[Group1] = "ONE_LEVEL" };
    key <LWIN> { [ ISO_Level3_Shift ], type[Group1] = "ONE_LEVEL" };
};
