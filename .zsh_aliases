alias _source="source $HOME/.zshrc"

alias c="cursor ."
alias nv="nvim ."
alias tf="terraform"

alias cat="bat --theme=Dracula --color=always --style=numbers"
alias ls="eza --long --icons=always --group-directories-first"
alias lst="ls --tree"
alias fzfp="fzf --preview \"cat --line-range=:500 {}\""
